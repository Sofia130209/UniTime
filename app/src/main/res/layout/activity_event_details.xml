<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC"
    android:fitsSystemWindows="true">

    <!-- Фоновое изображение -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Фон" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="16dp"
            android:paddingBottom="40dp">

            <!-- Кнопка назад -->
            <TextView
                android:id="@+id/backButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="← Назад"
                android:textColor="#3B66B0"
                android:textSize="16sp"
                android:fontFamily="@font/geist_semibold"
                android:paddingVertical="12dp"
                android:layout_marginBottom="8dp" />

            <!-- Основная информация -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#E8E9EF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/detailCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Спорт"
                        android:textColor="#3B66B0"
                        android:textSize="14sp"
                        android:fontFamily="@font/geist_semibold" />

                    <TextView
                        android:id="@+id/detailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Вечерний футбол"
                        android:textColor="#20243A"
                        android:textSize="24sp"
                        android:fontFamily="@font/geist_semibold" />


                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:text="О мероприятии"
                        android:textColor="#20243A"
                        android:textSize="18sp"
                        android:fontFamily="@font/geist_semibold" />

                    <TextView
                        android:id="@+id/detailDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Описание мероприятия появится здесь."
                        android:textColor="#85899E"
                        android:textSize="15sp"
                        android:fontFamily="@font/geist_regular"
                        android:lineSpacingExtra="6dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Информация о мероприятии -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="#E8E9EF"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Детали"
                        android:textColor="#20243A"
                        android:textSize="18sp"
                        android:fontFamily="@font/geist_semibold" />

                    <TextView
                        android:id="@+id/detailDate"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Дата и время"
                        android:textColor="#555B70"
                        android:textSize="15sp"
                        android:fontFamily="@font/geist_regular" />

                    <TextView
                        android:id="@+id/detailLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Место проведения"
                        android:textColor="#555B70"
                        android:textSize="15sp"
                        android:fontFamily="@font/geist_regular" />

                    <TextView
                        android:id="@+id/detailParticipants"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="3 из 8 участников"
                        android:textColor="#555B70"
                        android:textSize="15sp"
                        android:fontFamily="@font/geist_regular" />

                    <!-- НОВЫЙ СПИСОК УЧАСТНИКОВ -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Участники:"
                        android:textColor="#20243A"
                        android:textStyle="bold"
                        android:fontFamily="@font/geist_semibold"
                        android:layout_marginTop="14dp"
                        android:textSize="18sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvParticipantsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false" /> <!-- nestedScrollingEnabled false важен, если внутри ScrollView -->
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Кнопка записи -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/detailJoinButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Присоединиться"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/geist_semibold"
                app:backgroundTint="#3B66B0"
                app:cornerRadius="20dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>