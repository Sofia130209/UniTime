<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FC"
    android:fitsSystemWindows="true">

    <!-- Фоновое изображение -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        android:src="@drawable/background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Фон" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="40dp">

            <!-- Заголовок -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Создать активность"
                android:textColor="#3B66B0"
                android:textSize="22sp"
                android:fontFamily="@font/oddval_semibold"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="32dp" />

            <!-- СЕКЦИЯ 1: Основная информация -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Основная информация"
                android:textColor="#20243A"
                android:textSize="16sp"
                android:fontFamily="@font/geist_semibold"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:strokeColor="#E8E9EF"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <EditText
                        android:id="@+id/eventTitleInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Название (например, вечерний футбол)"
                        android:fontFamily="@font/geist_regular"
                        android:inputType="text"
                        android:singleLine="true"
                        android:padding="16dp"
                        android:background="@null"
                        android:textColor="#20243A"
                        android:textColorHint="#A0A5B5"
                        android:textSize="16sp" />

                    <EditText
                        android:id="@+id/eventDescriptionInput"
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:hint="Описание мероприятия..."
                        android:fontFamily="@font/geist_regular"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:padding="16dp"
                        android:background="@null"
                        android:textColor="#20243A"
                        android:textColorHint="#A0A5B5"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- СЕКЦИЯ 2: Категория и детали -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Детали мероприятия"
                android:textColor="#20243A"
                android:textSize="16sp"
                android:fontFamily="@font/geist_semibold"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:strokeColor="#E8E9EF"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <!-- Категория (Spinner) -->
                    <Spinner
                        android:id="@+id/eventCategorySpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="56dp"
                        android:background="@null"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp" />

                    <!-- Дата -->
                    <EditText
                        android:id="@+id/eventDateInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Выберите дату"
                        android:fontFamily="@font/geist_regular"
                        android:clickable="true"
                        android:focusable="false"
                        android:padding="16dp"
                        android:background="@null"
                        android:textColor="#20243A"
                        android:textColorHint="#A0A5B5"
                        android:textSize="16sp" />

                    <!-- Время -->
                    <EditText
                        android:id="@+id/eventTimeInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Выберите время"
                        android:fontFamily="@font/geist_regular"
                        android:clickable="true"
                        android:focusable="false"
                        android:padding="16dp"
                        android:background="@null"
                        android:textColor="#20243A"
                        android:textColorHint="#A0A5B5"
                        android:textSize="16sp" />

                    <!-- Место -->
                    <EditText
                        android:id="@+id/eventLocationInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Место (например, спортивная площадка)"
                        android:fontFamily="@font/geist_regular"
                        android:inputType="text"
                        android:singleLine="true"
                        android:padding="16dp"
                        android:background="@null"
                        android:textColor="#20243A"
                        android:textColorHint="#A0A5B5"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- СЕКЦИЯ 3: Участники -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Участники"
                android:textColor="#20243A"
                android:textSize="16sp"
                android:fontFamily="@font/geist_semibold"
                android:layout_marginBottom="12dp"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="24dp"
                app:strokeColor="#E8E9EF"
                app:cardElevation="0dp"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <EditText
                        android:id="@+id/eventMaxParticipantsInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Максимальное количество (например, 10)"
                        android:fontFamily="@font/geist_regular"
                        android:inputType="number"
                        android:singleLine="true"
                        android:padding="16dp"
                        android:background="@null"
                        android:textColor="#20243A"
                        android:textColorHint="#A0A5B5"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Кнопка создания -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/createEventButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Создать активность"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/geist_semibold"
                app:backgroundTint="#3B66B0"
                app:cornerRadius="20dp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>