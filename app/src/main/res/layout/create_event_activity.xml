<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Заголовок -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Создать активность"
            android:textColor="#20243A"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Название -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Название активности"
            android:textColor="#20243A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/eventTitleInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:hint="Например, вечерний футбол"
            android:padding="12dp"
            android:singleLine="true"
            android:textSize="15sp" />

        <!-- Описание -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Описание"
            android:textColor="#20243A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/eventDescriptionInput"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:gravity="top"
            android:hint="Расскажите подробнее о мероприятии..."
            android:padding="12dp"
            android:textSize="15sp" />

        <!-- Категория -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Категория"
            android:textColor="#20243A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/eventCategorySpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text" />

        <!-- Дата -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Дата проведения"
            android:textColor="#20243A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/eventDateInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:clickable="true"
            android:focusable="false"
            android:hint="Выберите дату"
            android:padding="12dp" />

        <!-- Время -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Время начала"
            android:textColor="#20243A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/eventTimeInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:clickable="true"
            android:focusable="false"
            android:hint="Выберите время"
            android:padding="12dp" />

        <!-- Место -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Место проведения"
            android:textColor="#20243A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/eventLocationInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:hint="Например, спортивная площадка ВГУ"
            android:padding="12dp"
            android:singleLine="true" />

        <!-- Количество участников -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Максимальное количество участников"
            android:textColor="#20243A"
            android:textSize="15sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/eventMaxParticipantsInput"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@android:drawable/edit_text"
            android:hint="Например, 10"
            android:inputType="number"
            android:padding="12dp"
            android:singleLine="true" />

        <!-- Кнопка создания -->
        <Button
            android:id="@+id/createEventButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="20dp"
            android:text="Создать активность" />

    </LinearLayout>

</ScrollView>
